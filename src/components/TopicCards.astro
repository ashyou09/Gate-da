---
import { getCollection } from 'astro:content';
import { PRIORITY_LABEL, type Subject } from '../data/subjects';
interface Props { subject: Subject }
const { subject } = Astro.props;
const ids = new Set((await getCollection('docs')).map((e) => e.id));
---
<ol class="topics" aria-label={`${subject.name} topics`}>
  {subject.topics.map((t, i) => {
    const ready = t.page && ids.has(`${subject.slug}/${t.page}`);
    const Tag = ready ? 'a' : 'div';
    return (
      <li>
        <Tag class:list={['card', { ready }]} href={ready ? `/${subject.slug}/${t.page}/` : undefined}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="body">
            <span class="title">{t.title}</span>
            {t.blurb && <span class="blurb">{t.blurb}</span>}
            <span class="meta">
              <span class={`chip p-${t.priority}`}>{PRIORITY_LABEL[t.priority]}</span>
              {typeof t.pyqs === 'number' && (
                <span class="chip">{t.pyqs === 0 ? 'Not asked yet' : `${t.pyqs} PYQ${t.pyqs > 1 ? 's' : ''}`}</span>
              )}
              <span class:list={['status', { ready }]}>{ready ? 'Read notes →' : 'Coming soon'}</span>
            </span>
          </span>
        </Tag>
      </li>
    );
  })}
</ol>
<style>
  .topics { list-style: none; padding: 0; margin: 1.5rem 0 0.5rem; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .topics li { margin: 0; }
  .card { display: flex; gap: 0.9rem; height: 100%; padding: 1rem 1.1rem; border: 1px solid var(--gd-line); border-radius: 0.6rem; background: var(--gd-surface); color: inherit; text-decoration: none; }
  .card:not(.ready) { background: transparent; border-style: dashed; }
  .card.ready:hover, .card.ready:focus-visible { border-color: var(--gd-ink); box-shadow: 0 6px 20px -12px var(--gd-shadow); transform: translateY(-1px); }
  .card { transition: border-color .15s, box-shadow .15s, transform .15s; }
  .num { font: 700 1.25rem/1 var(--gd-display); color: var(--gd-ink); font-variant-numeric: tabular-nums; padding-top: 0.15rem; }
  .card:not(.ready) .num { color: var(--sl-color-gray-4); }
  .body { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .title { font: 650 1.02rem/1.3 var(--gd-display); color: var(--sl-color-white); }
  .blurb { font-size: 0.86rem; line-height: 1.5; color: var(--sl-color-gray-2); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: auto; padding-top: 0.25rem; }
  .chip { font: 500 0.7rem/1 var(--gd-mono); padding: 0.3rem 0.5rem; border-radius: 999px; background: var(--gd-chip); color: var(--sl-color-gray-2); white-space: nowrap; }
  .chip.p-high { background: var(--gd-hl); color: var(--gd-hl-ink); }
  .status { margin-left: auto; font-size: 0.78rem; font-weight: 600; color: var(--sl-color-gray-3); }
  .status.ready { color: var(--gd-ink); }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card.ready:hover { transform: none; } }
</style>
