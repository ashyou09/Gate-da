---
/**
 * Replaces Starlight's page title.
 *  - subject hub (`<slug>`)        → subject header + topic cards
 *  - topic page  (`<slug>/<page>`) → lesson header (topic n of N, priority, PYQs)
 *  - anything else                 → plain title
 */
const PAGE_TITLE_ID = '_top'; // same id Starlight uses for the page title anchor
import { bySlug, subjects, mean, PRIORITY_LABEL } from '../data/subjects';
import MarksBars from './MarksBars.astro';
import TopicCards from './TopicCards.astro';
import { getCollection } from 'astro:content';

const { entry } = Astro.locals.starlightRoute;
const isHome = entry.id === 'index' || entry.id === '' || entry.data.template === 'splash';
const [slug, page] = entry.id.split('/');
const subject = bySlug.get(slug);
const subjectNo = subject ? subjects.indexOf(subject) + 1 : 0;

let topicIndex = -1;
if (subject && page) topicIndex = subject.topics.findIndex((t) => t.page === page);
const topic = topicIndex >= 0 ? subject!.topics[topicIndex] : undefined;

let written = 0;
if (subject && !page) {
  const ids = new Set((await getCollection('docs')).map((e) => e.id));
  written = subject.topics.filter((t) => t.page && ids.has(`${slug}/${t.page}`)).length;
}
---

{isHome ? null : subject && !page ? (
  <header class="gd-hub">
    <p class="eyebrow">Subject {subjectNo} of {subjects.length} · {subject.short}</p>
    <h1 id={PAGE_TITLE_ID}>{subject.name}</h1>
    <p class="lede">{subject.note}</p>
    <div class="stats">
      <div class="stat">
        <span class="label">Marks in GATE DA</span>
        <MarksBars marks={subject.marks} />
      </div>
      <div class="stat">
        <span class="label">Average</span>
        <span class="big">{mean(subject.marks)}<small>/100</small></span>
      </div>
      <div class="stat">
        <span class="label">Notes written</span>
        <span class="big">{written}<small>/{subject.topics.length} topics</small></span>
        <span class="progress" style={`--p:${(written / subject.topics.length) * 100}%`}></span>
      </div>
    </div>
    <h2 class="topics-h">Topics, in study order</h2>
    <TopicCards subject={subject} />
  </header>
) : subject && topic ? (
  <header class="gd-lesson">
    <p class="eyebrow">
      <a href={`/${slug}/`}>{subject.short}</a> · Topic {topicIndex + 1} of {subject.topics.length}
    </p>
    <h1 id={PAGE_TITLE_ID}>{topic.title}</h1>
    <div class="chips">
      <span class={`chip p-${topic.priority}`}>{PRIORITY_LABEL[topic.priority]}</span>
      {typeof topic.pyqs === 'number' && <span class="chip">{topic.pyqs} PYQs in 2024–26</span>}
      <span class="chip">~2 h study</span>
    </div>
  </header>
) : (
  <h1 id={PAGE_TITLE_ID} class="gd-plain">{entry.data.title}</h1>
)}

<style>
  h1 { margin: 0.4rem 0 0; font: 750 clamp(2rem, 1.5rem + 2vw, 2.8rem)/1.08 var(--gd-display); letter-spacing: -0.02em; color: var(--sl-color-white); text-wrap: balance; }
  .gd-plain { margin-top: 1rem; }
  .eyebrow { margin: 0; font: 500 0.75rem/1.4 var(--gd-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .eyebrow a { color: var(--gd-ink); text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; }
  .lede { margin: 0.75rem 0 0; max-width: 60ch; font-size: 1.05rem; color: var(--sl-color-gray-2); }

  .stats { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .stat { display: flex; flex-direction: column; justify-content: space-between; gap: 0.5rem; min-width: 9rem; flex: 1 1 9rem; padding: 0.9rem 1rem; border: 1px solid var(--gd-line); border-radius: 0.6rem; background: var(--gd-surface); }
  .label { font: 500 0.68rem/1.3 var(--gd-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .big { font: 750 2rem/1 var(--gd-display); color: var(--sl-color-white); font-variant-numeric: tabular-nums; }
  .big small { font: 500 0.8rem var(--gd-body); color: var(--sl-color-gray-3); margin-left: 0.2rem; }
  .progress { height: 6px; border-radius: 3px; background: var(--gd-chip); position: relative; overflow: hidden; }
  .progress::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--p); background: var(--gd-ink); border-radius: 3px; }
  .topics-h { margin: 2.25rem 0 0; font: 700 1.35rem/1.2 var(--gd-display); color: var(--sl-color-white); }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
  .chip { font: 500 0.74rem/1 var(--gd-mono); padding: 0.35rem 0.6rem; border-radius: 999px; background: var(--gd-chip); color: var(--sl-color-gray-2); }
  .chip.p-high { background: var(--gd-hl); color: var(--gd-hl-ink); }
</style>
